# Annotations are the annotators' work, returned as files and collected
# elsewhere. Committing them would publish judgements made about real buildings
# and would conflict every time two people push.
annotator/annotations/*.json

# Built by annotator/build_site.py, and by the Pages workflow on every push.
dist/

# IFC files are kept out by default -- they are large and easy to add by
# accident. The 25 published with the annotator are the deliberate exception:
# without them the hosted 3D view has nothing to show.
*.ifc
!annotator/data/*.ifc
dataset/
results/

# Left beside a file by migrate_verdicts.py. Useful locally, never worth
# committing -- the version it backs up is already in the history.
*.bak

__pycache__/
*.py[cod]
.venv/
venv/
.DS_Store

# Only ever present when CI installs playwright for the browser test.
node_modules/
package-lock.json
